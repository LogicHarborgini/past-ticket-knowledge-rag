# Copy to .env and fill in your own values:  cp .env.example .env
# The real .env is gitignored — never commit it.

# AWS
# Credentials are NOT read from here. boto3 resolves them from the standard
# credential chain: `aws configure` locally, IAM role on Lambda/ECS.
AWS_DEFAULT_REGION=us-east-1

# Provider: auto | bedrock | ollama | fake
#   auto     bedrock if boto3 can resolve credentials, else ollama
#   fake     no model and no embedding service at all — canned answers plus
#            keyword embeddings. Retrieval still works and is deterministic, so
#            the pipeline, tracing and evals are exercisable offline. Must be set
#            explicitly; auto never selects it.
LLM_PROVIDER=auto

# Generation model
BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0
BEDROCK_MAX_TOKENS=768
# Lower than the first-response app on purpose: a summariser reading retrieved
# tickets should paraphrase them, not improvise around them.
BEDROCK_TEMPERATURE=0.1
OLLAMA_MODEL=llama3.2

# Embedding model — must match the one the index was built with. Re-embedding
# the corpus with a different model without re-ingesting produces silent garbage
# retrieval: the query vector and the stored vectors live in different spaces.
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Retrieval
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION=past_tickets
RETRIEVAL_TOP_K=3
# Minimum similarity for a document to be retrieved. Leave unset to retrieve the
# k nearest regardless of distance. Set it — after looking at the score
# distribution on your own index — when RAGAS context precision is low.
# RETRIEVAL_SCORE_THRESHOLD=0.5

# RAGAS judge (evals/ragas_eval.py, run in the separate eval virtualenv).
# JUDGE_PROVIDER defaults to LLM_PROVIDER; set it only to judge on a provider
# the app itself does not use — 'openai' is a valid judge and not a valid app
# setting. Judge defaults are cheaper/smaller than the chain's on purpose: the
# judge fires once per metric per sample.
# JUDGE_PROVIDER=bedrock
JUDGE_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
JUDGE_OLLAMA_MODEL=llama3.2
# JUDGE_OPENAI_MODEL=gpt-4o-mini

# Analytics log (SQL)
# One row per search, plus one per retrieved ticket. This is what the
# /api/v1/analytics/* endpoints read.
#
# The variable is deliberately the conventional DATABASE_URL, which most deploy
# platforms (Railway, Render, Heroku) inject automatically when you attach a
# Postgres instance — attach one and the log moves to Postgres with no code or
# config change. Locally it is a SQLite file you can open in DB Browser.
DATABASE_URL=sqlite:///./ptk_analytics.db
# Set false to stop persisting searches — useful under load testing, where the
# log measures the log.
LOG_SEARCHES=true

# API
APP_TITLE=Past Ticket Knowledge API
APP_VERSION=1.0.0
LOG_LEVEL=INFO

# LangSmith observability
# Create a key at https://smith.langchain.com/settings -> API Keys
# Set LANGSMITH_TRACING=false to turn tracing off without removing the key.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_pt_your_key_here
LANGSMITH_PROJECT=ptk-support-assistant
